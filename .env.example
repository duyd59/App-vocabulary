# GEMINI_API_KEY: Required for Gemini AI API calls.
# In Coolify: Add GEMINI_API_KEY in your Resource -> Environment Variables tab.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# Server Configuration (Coolify automatically maps PORT=3000)
NODE_ENV="production"
PORT="3000"
HOST="0.0.0.0"

# APP_URL: The public domain/URL where this applet is hosted.
APP_URL="https://your-domain.com"

